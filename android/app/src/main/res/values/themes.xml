<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FieldMonitoring" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.FieldMonitoring.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.FieldMonitoring</item>
    </style>
</resources>
